# ==============================================================================
# KAIRO AI — Production & Development Environment Configuration
# ==============================================================================
# IMPORTANT: Never commit actual API keys or secrets to version control.
# Copy this file to .env and provide your actual credentials.
#
# On Netlify: Add GEMINI_API_KEY in Netlify Site Settings > Environment variables.
# ==============================================================================

# Required: Google Gemini API Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Gemini Model (defaults to gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# Server Port (Local Express Relay)
PORT=5000

# Client Origin (CORS whitelist for local development)
CLIENT_ORIGIN=http://localhost:5173
